# Основные настройки
SECRET_KEY=your-secret-key-here

# Часовой пояс
TIMEZONE=Europe/Moscow

# Настройки Ollama
OLLAMA_URL=http://host.docker.internal:11434
LLM_CHAT_MODEL=qwen3-vl:8b-instruct-q4_K_M
LLM_CHAT_MODEL_CONTEXT_WINDOW=32768
LLM_MULTIMODAL_MODEL=qwen3-vl:8b-instruct-q4_K_M
LLM_MULTIMODAL_MODEL_CONTEXT_WINDOW=32768
LLM_REASONING_MODEL=gpt-oss:20b
LLM_REASONING_MODEL_CONTEXT_WINDOW=65536
# Опционально: отдельные модели для разных задач
# LLM_MATH_MODEL=gpt-oss:20b
# LLM_CODE_MODEL=gpt-oss:20b

# Подпись в футере (единая для сайта и сохранённых чатов)
FOOTER_TEXT="ИИ Локальный v1.2 (с) 2026 Барсуков Валерий"