# ОСНОВНЫЕ НАСТРОЙКИ (ВСЕ ПЕРЕМЕННЫЕ ОБЯЗАТЕЛЬНЫ)
# ==================================================

# Секретный ключ для сессий Flask (обязателен)
SECRET_KEY=your-secret-key-here

# Часовой пояс (обязателен, например: Europe/Moscow, UTC, Europe/London)
TIMEZONE=Europe/Moscow

# Настройки для изображений (обязательны)
MAX_IMAGE_WIDTH=3840
MAX_IMAGE_HEIGHT=2160
MAX_IMAGE_SIZE_MB=5

# Настройки Ollama (все обязательны)
OLLAMA_URL=http://host.docker.internal:11434

# Модель-маршрутизатор (чат модель) - обязательна
LLM_CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M
LLM_CHAT_MODEL_CONTEXT_WINDOW=8192
LLM_CHAT_TEMPERATURE=0.1
LLM_CHAT_TOP_P=0.1
LLM_CHAT_TIMEOUT=60

# Мультимодальная модель (для изображений) - обязательна
LLM_MULTIMODAL_MODEL=qwen3-vl:8b-instruct-q4_K_M
LLM_MULTIMODAL_MODEL_CONTEXT_WINDOW=16384
LLM_MULTIMODAL_TEMPERATURE=0.7
LLM_MULTIMODAL_TOP_P=0.9
LLM_MULTIMODAL_TIMEOUT=120

# Reasoning модель (для сложных запросов) - обязательна
LLM_REASONING_MODEL=gpt-oss:20b
LLM_REASONING_MODEL_CONTEXT_WINDOW=32768
LLM_REASONING_TEMPERATURE=0.7
LLM_REASONING_TOP_P=0.9
LLM_REASONING_TIMEOUT=300

# Настройки Automatic1111 (обязателен для генерации изображений)
AUTOMATIC1111_URL=http://host.docker.internal:7860
# Модель для Automatic1111 (Stable Diffusion checkpoint)
AUTOMATIC1111_MODEL=cyberrealisticXL_v90.safetensors
# Таймаут для генерации изображений
AUTOMATIC1111_TIMEOUT=180

# URL для Whisper API (транскрибация аудио)
WHISPER_API_URL=http://host.docker.internal:9000/asr
# Таймаут для транскрибации аудио
WHISPER_API_TIMEOUT=120

# Настройки системы видеонаблюдения
CAMERA_API_URL=http://host.docker.internal:5005
CAMERA_ENABLED=true                # true - модуль включён, false - отключён
# Таймаут для получения снимков с камер
CAMERA_API_TIMEOUT=15
# Интервал проверки доступности камер (секунды)
CAMERA_CHECK_INTERVAL=30