# ==================== СИСТЕМНЫЕ НАСТРОЙКИ ====================
# Часовой пояс (обязателен)
TIMEZONE=Europe/Moscow

# Порт приложения
APP_PORT=5000

# ==================== НАСТРОЙКИ ИЗОБРАЖЕНИЙ ====================
MAX_IMAGE_WIDTH=3840
MAX_IMAGE_HEIGHT=2160
MAX_IMAGE_SIZE_MB=5

# ==================== OLLAMA ====================
# URL Ollama (для Docker: host.docker.internal или имя сервиса)
OLLAMA_URL=http://host.docker.internal:11434
# Для Linux без host.docker.internal раскомментируйте:
# OLLAMA_URL=http://172.17.0.1:11434

# --- Чат-модель (маршрутизатор + простые запросы) ---
LLM_CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M
LLM_CHAT_MODEL_CONTEXT_WINDOW=32768
LLM_CHAT_TEMPERATURE=0.1
LLM_CHAT_TOP_P=0.1

# --- Мультимодальная модель (анализ изображений) ---
LLM_MULTIMODAL_MODEL=qwen3-vl:8b-instruct-q4_K_M
LLM_MULTIMODAL_MODEL_CONTEXT_WINDOW=32768
LLM_MULTIMODAL_TEMPERATURE=0.7
LLM_MULTIMODAL_TOP_P=0.9

# --- Reasoning модель (сложные запросы) ---
LLM_REASONING_MODEL=qwen3:8b-q4_K_M
LLM_REASONING_MODEL_CONTEXT_WINDOW=40960
LLM_REASONING_TEMPERATURE=0.7
LLM_REASONING_TOP_P=0.9

# ==================== AUTOMATIC1111 ====================
AUTOMATIC1111_URL=http://host.docker.internal:7860
# Модель Stable Diffusion (раскомментируйте нужную)
#AUTOMATIC1111_MODEL=cyberrealistic_final.safetensors
#AUTOMATIC1111_MODEL=cyberrealisticXL_v80.safetensors
AUTOMATIC1111_MODEL=cyberrealisticXL_v90.safetensors

# Параметры генерации
A1111_STEPS=30
A1111_CFG_SCALE=7
A1111_WIDTH=1024
A1111_HEIGHT=1024
A1111_SAMPLER=Euler a

# ==================== QDRANT (опционально, для RAG) ====================
# QDRANT_URL=http://host.docker.internal:6333
# QDRANT_COLLECTION=ai_local_docs

# ==================== БЕЗОПАСНОСТЬ ====================
# Секретный ключ для сессий (сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=change_this_in_production

# ==================== ПОДВАЛ ====================
FOOTER_TEXT="ИИ Локальный v3.3 (с) 2026 Барсуков Валерий"