#!/usr/bin/env python3
"""Reject Cyrillic in commit messages.

Commit messages are written in English. Russian is allowed only for proper
nouns (the localized brand name) and verbatim quoted user-facing strings.
Enable the hook once per clone:

    git config core.hooksPath .githooks
"""

from __future__ import annotations

import re
import sys

# Proper nouns that may stay in Russian inside an English message.
ALLOWED = ("ПЛИИ",)


def main() -> int:
    path = sys.argv[1]
    with open(path, encoding="utf-8") as fh:
        lines = [line for line in fh.read().splitlines() if not line.startswith("#")]
    message = "\n".join(lines)
    for token in ALLOWED:
        message = message.replace(token, "")
    if re.search(r"[\u0400-\u04FF]", message):
        sys.stderr.write(
            "commit-msg: commit messages must be in English "
            "(Russian is allowed only for proper nouns such as the brand name).\n"
        )
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
