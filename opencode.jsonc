{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "git add *", "effect": "ask" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git tag *", "effect": "ask" },
    { "action": "shell", "resource": "git revert *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" }
  ],
  "agents": {
    "general": {
      "permissions": [
        { "action": "shell", "resource": "git add *", "effect": "deny" },
        { "action": "shell", "resource": "git commit *", "effect": "deny" },
        { "action": "shell", "resource": "git tag *", "effect": "deny" },
        { "action": "shell", "resource": "git revert *", "effect": "deny" },
        { "action": "shell", "resource": "git push *", "effect": "deny" },
        { "action": "shell", "resource": "git merge *", "effect": "deny" }
      ]
    },
    "explore": {
      "permissions": [
        { "action": "shell", "resource": "git add *", "effect": "deny" },
        { "action": "shell", "resource": "git commit *", "effect": "deny" },
        { "action": "shell", "resource": "git tag *", "effect": "deny" },
        { "action": "shell", "resource": "git revert *", "effect": "deny" },
        { "action": "shell", "resource": "git push *", "effect": "deny" },
        { "action": "shell", "resource": "git merge *", "effect": "deny" }
      ]
    }
  }
}
