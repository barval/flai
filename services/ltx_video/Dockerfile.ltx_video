# Dockerfile for LTX-Video inference server
# Parameterized by LTX_BACKEND: cuda (default) or cpu.
# Each backend is tagged separately so GPU and CPU images coexist (see
# docker-compose.gpu.yml / docker-compose.cpu.yml) — switching stacks never
# rebuilds:
#
#   CUDA: docker build -f services/ltx_video/Dockerfile.ltx_video -t flai-ltxvideo:cuda .
#   CPU:  docker build --build-arg LTX_BACKEND=cpu \
#          --build-arg LTX_BASE_IMAGE=python:3.11-slim \
#          -f services/ltx_video/Dockerfile.ltx_video -t flai-ltxvideo:cpu .

ARG LTX_BACKEND=cuda
ARG LTX_BASE_IMAGE=pytorch/pytorch:2.5.0-cuda12.4-cudnn9-runtime

FROM ${LTX_BASE_IMAGE}

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    ffmpeg \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    "git+https://github.com/Lightricks/LTX-Video.git" \
    flask \
    gunicorn \
    pyyaml \
    imageio \
    imageio-ffmpeg \
    av \
    redis

# Install the right PyTorch build for the selected backend.
# CUDA: nightly cu128 for RTX 5060 Ti (sm_120) support.
# CPU:  official CPU wheels from the pytorch.org index.
# Must be AFTER ltx-video install, otherwise pip downgrades torch.
ARG LTX_BACKEND
RUN if [ "${LTX_BACKEND}" = "cpu" ]; then \
        pip install --no-cache-dir --force-reinstall torch --index-url https://download.pytorch.org/whl/cpu && \
        pip install --no-cache-dir --force-reinstall --no-deps torchvision --index-url https://download.pytorch.org/whl/cpu; \
    else \
        pip install --no-cache-dir --force-reinstall --pre torch --index-url https://download.pytorch.org/whl/nightly/cu128 && \
        pip install --no-cache-dir --force-reinstall --pre --no-deps torchvision --index-url https://download.pytorch.org/whl/nightly/cu128; \
    fi

# Create directories
RUN mkdir -p /app/models \
    /app/models/huggingface \
    /app/logs

WORKDIR /app

COPY ltx_wrapper.py /app/ltx_wrapper.py

# Port for HTTP wrapper
EXPOSE 7872

ENV HF_HOME=/app/models/huggingface

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=180s \
    CMD curl -f http://localhost:7872/health || exit 1

CMD ["gunicorn", "-w", "1", "-b", "0.0.0.0:7872", "--timeout", "600", "--access-logfile", "-", "--error-logfile", "-", "ltx_wrapper:app"]
