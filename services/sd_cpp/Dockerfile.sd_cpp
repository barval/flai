# Dockerfile for stable-diffusion.cpp with selectable backend
# Builds for CUDA (default), Vulkan, or pure CPU via the SD_BACKEND build arg.
# Each backend is tagged separately so GPU and CPU images coexist (see
# docker-compose.gpu.yml / docker-compose.cpu.yml) — switching stacks never
# rebuilds:
#
#   docker build --build-arg SD_BACKEND=cuda   -f services/sd_cpp/Dockerfile.sd_cpp -t flai-sd_cpp:cuda .
#   docker build --build-arg SD_BACKEND=vulkan -f services/sd_cpp/Dockerfile.sd_cpp -t flai-sd_cpp:vulkan .
#   docker build --build-arg SD_BACKEND=cpu    -f services/sd_cpp/Dockerfile.sd_cpp -t flai-sd_cpp:cpu .

ARG SD_BACKEND=cuda
ARG CUDA_VERSION=13.0.1
ARG UBUNTU_VERSION=24.04

# ── Build stage ──
FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION} AS build_cuda

FROM ubuntu:${UBUNTU_VERSION} AS build_vulkan

FROM ubuntu:${UBUNTU_VERSION} AS build_cpu

FROM build_${SD_BACKEND} AS build

ARG SD_BACKEND

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    ccache \
    cmake \
    ca-certificates \
    && if [ "${SD_BACKEND}" = "cuda" ]; then \
         true; \
       elif [ "${SD_BACKEND}" = "vulkan" ]; then \
         apt-get install -y --no-install-recommends libvulkan-dev glslc spirv-headers; \
       fi \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /sd.cpp

# Pin the runtime: a floating clone made every rebuild a different engine (the
# image we ran was master-908, upstream was master-1017 = 109 commits ahead).
ARG SD_CPP_COMMIT=be486498eadc29dc3cd234d944c2180ed42b1415
RUN git init -q . \
    && git remote add origin https://github.com/leejet/stable-diffusion.cpp.git \
    && git fetch -q --depth 1 origin "${SD_CPP_COMMIT}" \
    && git checkout -q FETCH_HEAD \
    && git submodule update --init --recursive --depth 1

ARG SD_BACKEND
# CUDA arch for the CUDA build. Docker has no GPU during `build`, so ggml's
# "-arch=native" cannot resolve and silently falls back to a default arch (the
# runner then JIT-compiles for sm_120 on first use). Pass the real one:
#   docker build --build-arg CUDA_ARCHITECTURES=120 ...
# or "86;89;120" for an image that runs on every supported tier.
ARG CUDA_ARCHITECTURES=native
RUN if [ "${SD_BACKEND}" = "cuda" ]; then \
        cmake . -B ./build -DSD_CUDA=ON -DCUDACXX=/usr/local/cuda/bin/nvcc \
              -DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCHITECTURES}; \
    elif [ "${SD_BACKEND}" = "vulkan" ]; then \
        cmake . -B ./build -DSD_VULKAN=ON; \
    else \
        cmake . -B ./build; \
    fi && \
    cmake --build ./build --config Release -j$(nproc)

# ── Runtime stage ──
FROM nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu${UBUNTU_VERSION} AS runtime_cuda

FROM ubuntu:${UBUNTU_VERSION} AS runtime_vulkan

FROM ubuntu:${UBUNTU_VERSION} AS runtime_cpu

ARG SD_BACKEND
FROM runtime_${SD_BACKEND} AS runtime

ARG SD_BACKEND
ENV SD_BACKEND=${SD_BACKEND}

RUN apt-get update && apt-get install --yes --no-install-recommends \
    libgomp1 curl python3 python3-requests adduser \
    && if [ "${SD_BACKEND}" = "vulkan" ]; then \
         apt-get install --yes --no-install-recommends libvulkan1; \
       fi \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy sd-cli built in the build stage (self-contained, no CUDA libs needed on host)
COPY --from=build /sd.cpp/build/bin/sd-cli /usr/local/bin/sd-cli
COPY --from=build /sd.cpp/build/bin/sd-server /usr/local/bin/sd-server

# Create directories for models
RUN mkdir -p /app/models/diffusion_models \
             /app/models/vae \
             /app/models/text_encoders \
             /app/outputs

WORKDIR /app

EXPOSE 7861

RUN addgroup --system --gid 1001 appuser && \
    adduser --system --uid 1001 --gid 1001 appuser && \
    mkdir -p /app/logs && \
    chown -R appuser:appuser /app

USER appuser

CMD ["python3", "sd_wrapper.py"]