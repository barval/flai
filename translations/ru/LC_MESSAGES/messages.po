msgid "Page reading service is unavailable"
msgstr "⚠️ Сервис чтения страниц недоступен"

#: app/tools.py:972
msgid "Failed to read the page"
msgstr "⚠️ Не удалось прочитать страницу"

#: app/tools.py:983
msgid "Document search service unavailable"
msgstr "Сервис поиска в документах недоступен"

#: app/tools.py:986
msgid "User not identified for document search"
msgstr "Пользователь не идентифицирован для поиска в документах"

#: app/tasks/runner.py:591 app/tools.py:997
#, python-brace-format
msgid "No relevant documents found for query: {query}"
msgstr "Релевантные документы не найдены для запроса: {query}"

#: app/tools.py:1019
msgid "User not identified for conversation search"
msgstr "Пользователь не идентифицирован для поиска по истории диалогов"

#: app/tools.py:1039
#, python-brace-format
msgid "No past conversations found for query: {query}"
msgstr "Прошлые диалоги по запросу «{query}» не найдены"

#: app/tools.py:1053 app/tools.py:1088 modules/cam.py:409 modules/cam.py:536
msgid "CCTV service unavailable"
msgstr "Сервис видеонаблюдения недоступен"

#: app/tools.py:1066
msgid ""
"What is visible in this room right now? Name people, animals, objects and"
" activity."
msgstr ""
"Что сейчас видно в этой комнате? Назови людей, животных, предметы и "
"происходящее действие."

#: app/tools.py:1076
msgid "Snapshot captured; no description is available."
msgstr "Снимок получен, но описание недоступно."

#: app/tools.py:1175 app/tools.py:1182 app/tools.py:1198 app/tools.py:1245
#: app/tools.py:1248 app/tools.py:1256 app/tools.py:1302 app/tools.py:1305
#: app/tools.py:1313 app/tools.py:1320 app/tools.py:1330 app/tools.py:1359
