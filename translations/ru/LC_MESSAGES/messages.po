msgid "Date calculation error: {error}"
msgstr "Ошибка вычисления даты: {error}"

#: app/tools.py:1355
#, python-brace-format
msgid "Unknown time_calc operation: {op}"
msgstr "Неизвестная операция time_calc: {op}"

#: app/tools.py:1416
msgid "User not identified for network tools"
msgstr "Пользователь не определён для сетевых инструментов"

#: app/tools.py:1418
msgid "Network tools are not available to you."
msgstr "Сетевые инструменты Вам недоступны."

#: app/tools.py:1420
msgid "The network diagnostics service is not running"
msgstr "Служба сетевой диагностики не запущена"

#: app/tools.py:1425
#, python-brace-format
msgid "This address is refused: {reason}"
msgstr "Этот адрес запрещён: {reason}"

#: app/tools.py:1425
msgid "loopback or link-local"
msgstr "петля или link-local"

# GPU memory error messages
#: app/tools.py:1429
msgid "Too many network calls; try again in a minute."
msgstr "Слишком много сетевых вызовов; попробуйте через минуту."

#: app/tools.py:1438
msgid "The diagnostics service returned nothing"
msgstr "Служба диагностики ничего не вернула"

#: app/tools.py:1508
msgid "I could not tell the time. When should it happen?"
msgstr "Не понял время. Когда это должно произойти?"

#: app/tools.py:1514
#, python-brace-format
msgid ""
"An action cannot run more often than every {minutes} minutes on this "
"installation"
msgstr ""
"На этом инстансе действие не может запускаться чаще, чем раз в {minutes} "
"минут"

#: app/tools.py:1516
#, python-brace-format
msgid "A reminder cannot repeat more often than every {minutes} minutes"
msgstr "Напоминание не может повторяться чаще, чем раз в {minutes} минут"

#: app/tools.py:1520
msgid "That repetition is not one I know: once, daily, weekly, monthly or minutes"
msgstr ""
"Такое повторение мне неизвестно: разово, ежедневно, еженедельно, "
"ежемесячно или каждые минуты"

#: app/tools.py:1522
msgid "I could not tell which weekdays. Name them as 1 = Monday … 7 = Sunday"
msgstr ""
"Не могу понять, какие дни недели. Назовите их числами: 1 — понедельник … "
"7 — воскресенье"

#: app/tools.py:1524
msgid "Several weekdays only make sense for a weekly schedule"
